# 本地密钥模板。复制为 .env 后填入自己的 key。
# .env 已在 .gitignore 中，不要提交、不要贴进对话或日志。
#
# 生成玩法一句话 / 玩法类型 / 中文译名：scripts/gen_cn_blurb.py
#   python scripts/gen_cn_blurb.py --dry-run     # 不调用模型，只看待处理条目
#   python scripts/gen_cn_blurb.py               # 生成最新榜日当日进榜产品
#
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
